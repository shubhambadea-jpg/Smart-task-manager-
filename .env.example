# GEMINI_API_KEY: Required for Google Gemini 3.8 Flash AI calls (goal breakdown, daily planner, prioritization)
# AI Studio automatically injects this at runtime from user secrets.
# When omitted, TaskFlow runs with high-fidelity built-in heuristic generators.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Configuration (Optional - TaskFlow works out-of-the-box in local Demo Mode if omitted)
# To enable real Firebase Authentication and Cloud Firestore cloud sync, set these variables:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Server Port
PORT=3000
